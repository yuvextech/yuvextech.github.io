rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['yuvextech@gmail.com', 'ywapne@gmail.com', 'yovses@gmail.com'];
    }

    function textOk(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }

    function optText(d, k, hi) {
      return !(k in d) || (d[k] is string && d[k].size() <= hi);
    }

    function isValidComment(d) {
      return textOk(d.author, 1, 100) && textOk(d.text, 1, 3000)
        && optText(d, 'postId', 200) && optText(d, 'email', 254) && optText(d, 'avatar', 2048);
    }

    function isValidInquiry(d) {
      return textOk(d.name, 1, 150) && textOk(d.email, 3, 254) && textOk(d.message, 1, 5000)
        && d.status == 'unread' && optText(d, 'source', 200) && optText(d, 'phone', 50);
    }

    function isValidSubscriber(d) {
      return textOk(d.email, 3, 254) && d.status == 'active' && optText(d, 'name', 150);
    }

    function isValidReview(d) {
      return textOk(d.author, 1, 150) && textOk(d.quote, 1, 3000)
        && d.status == 'pending' && d.verified == false
        && optText(d, 'role', 150) && optText(d, 'company', 150) && optText(d, 'avatar', 400000);
    }

    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /team_members/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cpanel_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /test/{id} {
      allow read: if true;
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if isValidComment(request.resource.data) || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isValidReview(request.resource.data) || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /inquiries/{id} {
      allow create: if isValidInquiry(request.resource.data) || isAdmin();
      allow read, update, delete: if isAdmin();
    }
    match /subscribers/{id} {
      allow create: if isValidSubscriber(request.resource.data) || isAdmin();
      allow read, update, delete: if isAdmin();
    }
  }
}
